# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
POSTGRES_USER=localledger
POSTGRES_PASSWORD=change-me
POSTGRES_DB=localledger
POSTGRES_PORT=5432

# --- API ------------------------------------------------------------------
API_PORT=8000
LOG_LEVEL=INFO

# --- Ollama (runs natively on the host, not in Docker) --------------------
# On macOS: brew install ollama && brew services start ollama
OLLAMA_URL=http://host.docker.internal:11434

# The vision model used for field extraction. Set this to your preferred
# local model, then `ollama pull <name>` on the host before first run.
# There is no default on purpose — the appliance refuses to start rather than
# silently using a model you did not choose.
OLLAMA_VISION_MODEL=

# Vision extraction on a large PDF page can be slow; give it room.
OLLAMA_TIMEOUT_SECONDS=180

# --- Folder-drop watcher --------------------------------------------------
WATCH_ENABLED=true
WATCH_INTERVAL_SECONDS=5
